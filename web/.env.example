# Base URL of the Java auth-service backend. Server-only — never exposed to the browser.
AUTH_API_URL=http://localhost:8080

# Random 32+ char secret used to encrypt the iron-session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse the same value across environments; rotating it invalidates all sessions.
SESSION_SECRET=
